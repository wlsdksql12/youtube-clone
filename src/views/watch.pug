extends base.pug

block content
    div#videoContainer(data-id=video._id)
        video(src="/"+video.fileUrl, controls)
        div#videoControls
            button#play Play 
            button#mute Mute
            input(type="range", step="0.1", min="0", max="1" value=0.5)#volume
            div
                span#currenTime 00:00
                span  /  
                span#totalTime 00:00
            div 
                input(type="range", step="1", min="0", value="0")#timeline
            div 
                button#fullScreen Enter Full Screen
        hr
        div
            p=video.description
            p #{video.meta.views} #{video.meta.views < 1 ? "view" : "views"}
            small=video.createdAt
        div
            small Uploaded By 
                a(href=`/user/${video.owner._id}`)=video.owner.name
        if String(video.owner._id) === String(loggedInUser._id)
            a(href=`${video.id}/edit`) Edit Video &rarr;
            br
            a(href=`${video.id}/delete`) Delete Video &rarr;


block script
    script(src="/assets/js/videoPlayer.js")